{
  "expo": {
    "name": "家計簿",
    "slug": "kakeibo",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kakeibo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kadosoft.kakeibo",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "アプリの利用に合わせた広告を表示するために使用します。許可しなくてもすべての機能を利用できます。"
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.kadosoft.kakeibo",
      "adaptiveIcon": {
        "backgroundColor": "#1B90D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "com.google.android.gms.permission.AD_ID"
      ],
      "allowBackup": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0EA5E9"
        }
      ],
      "expo-font",
      "expo-iap",
      "expo-tracking-transparency",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-6679521980469914~7448722473",
          "userTrackingUsageDescription": "アプリの利用に合わせた広告を表示するために使用します。許可しなくてもすべての機能を利用できます。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "admobBannerIos": "ca-app-pub-6679521980469914/1297307746",
      "admobBannerAndroid": "",
      "router": {},
      "eas": {
        "projectId": "94b57465-4a7a-4d47-a0de-78fc2b98e6ab"
      }
    },
    "owner": "kadoria"
  }
}